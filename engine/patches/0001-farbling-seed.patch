new file mode 100644
index 0000000000..42a16057ef
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/alter_farbling.h
@@ -0,0 +1,103 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * Alter's fingerprinting defences ("farbling"), after Brave's
+ * brave_session_cache (Copyright (c) 2020 The Brave Authors). */
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_ALTER_FARBLING_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_ALTER_FARBLING_H_
+
+#include <array>
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+// How hard a page's fingerprinting reads are disturbed. Standard keeps every
+// value plausible and pages working; Strict trades some compatibility away.
+enum class AlterFarblingLevel { kOff, kStandard, kStrict };
+
+// Keys for values farbled independently of each other from the same token.
+enum class AlterFarbleKey : uint64_t {
+  kNone = 0,
+  kAudio,
+  kCanvas,
+  kWebGL,
+  kNavigator,
+  kScreen,
+  kFonts,
+  kDevices,
+};
+
+// One per execution context (window, worker, worklet). The token comes from
+// the session key Alter hands each renderer (--alter-farbling-key, new every
+// launch) and the top-level site, so a site sees the same values for the
+// whole session, different sites see different ones, and a new session
+// starts fresh. Without the switch (stock shell, tests) everything is off.
+class CORE_EXPORT AlterFarbling final : public GarbageCollected<AlterFarbling>,
+                                        public Supplement<ExecutionContext> {
+ public:
+  static const char kSupplementName[];
+
+  // Null when protection is off for this context (no key, off by switch, or
+  // a page that is ours or local: file:, extensions, devtools, chrome:).
+  static AlterFarbling* From(ExecutionContext* context);
+
+  AlterFarbling(ExecutionContext& context,
+                const std::array<uint8_t, 32>& token,
+                AlterFarblingLevel level);
+
+  AlterFarblingLevel level() const { return level_; }
+
+  // A seed for one surface: same site, session and key give the same seed.
+  uint64_t Seed(AlterFarbleKey key) const;
+
+  // Flips the lowest bit of a few colour channels in RGBA8 pixel data. Which
+  // pixels depends on the token and on the pixels themselves, so the same
+  // drawing reads back the same way on a site, and differently elsewhere.
+  void PerturbPixels(base::span<uint8_t> rgba) const;
+
+  // Audio samples a page reads: scaled by a factor just under 1, plus
+  // inaudible noise in Strict. Inaudible, so it may apply in place.
+  void FarbleAudio(base::span<float> samples) const;
+  float AudioFactor() const { return audio_factor_; }
+
+  // The GPU a page is told about (WEBGL_debug_renderer_info): the same common
+  // one for every Effie on this system, instead of this machine's own.
+  static const char* GpuVendor();
+  static const char* GpuRenderer();
+
+  void Trace(Visitor* visitor) const override;
+
+ private:
+  std::array<uint8_t, 32> token_;
+  AlterFarblingLevel level_;
+  float audio_factor_;
+};
+
+// A small deterministic generator for farbled values (splitmix64).
+class AlterFarblingPRNG {
+ public:
+  explicit AlterFarblingPRNG(uint64_t seed) : state_(seed) {}
+  uint64_t operator()() {
+    uint64_t z = (state_ += 0x9e3779b97f4a7c15ull);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ull;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+    return z ^ (z >> 31);
+  }
+  // A double in [0, 1).
+  double NextDouble() { return ((*this)() >> 11) * 0x1.0p-53; }
+
+ private:
+  uint64_t state_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_ALTER_FARBLING_H_
