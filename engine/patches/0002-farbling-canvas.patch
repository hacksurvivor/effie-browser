@@ -136,6 +136,26 @@ base::span<const uint8_t> ImageDataBuffer::PixelData() const {
   return gfx::SkPixmapToSpan(pixmap_);
 }
 
+void ImageDataBuffer::MutatePixels(
+    base::FunctionRef<void(base::span<uint8_t>)> mutate) {
+  if (!is_valid_ || pixmap_.info().bytesPerPixel() != 4) {
+    return;
+  }
+  const SkImageInfo info = pixmap_.info();
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size)) {
+    return;
+  }
+  sk_sp<SkData> copy = SkData::MakeUninitialized(size);
+  if (!pixmap_.readPixels(info, copy->writable_data(), row_bytes)) {
+    return;
+  }
+  alter_pixels_ = std::move(copy);
+  pixmap_ = {info, alter_pixels_->writable_data(), row_bytes};
+  mutate(gfx::SkPixmapToWritableSpan(pixmap_));
+}
