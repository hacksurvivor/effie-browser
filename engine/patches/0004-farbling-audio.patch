+void AudioBuffer::AlterFarble(v8::Isolate* isolate) {
+  if (alter_farbled_) {
+    return;
+  }
+  alter_farbled_ = true;
+  AlterFarbling* farbling =
+      AlterFarbling::From(isolate ? CurrentExecutionContext(isolate) : nullptr);
+  if (!farbling) {
+    return;
+  }
+  for (auto& channel : channels_) {
+    if (channel) {
+      farbling->FarbleAudio(channel->AsSpan());
+    }
+  }
