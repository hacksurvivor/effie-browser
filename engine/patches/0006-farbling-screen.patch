+// Alter: common screen sizes. A page is told the smallest one its window fits
+// in, so the screen says nothing its window size doesn't already: not the
+// display, not the taskbar or Dock, not where other monitors are.
+gfx::Rect AlterCommonScreen(const gfx::Size& window) {
+  static constexpr int kCommon[][2] = {
+      {1280, 720},  {1366, 768},  {1440, 900},  {1536, 864},
+      {1600, 900},  {1680, 1050}, {1920, 1080}, {1920, 1200},
+      {2560, 1440}, {3440, 1440}, {3840, 2160},
+  };
+  for (const auto& size : kCommon) {
+    if (window.width() <= size[0] && window.height() <= size[1]) {
+      return gfx::Rect(size[0], size[1]);
+    }
+  }
+  return gfx::Rect(window);
+}
