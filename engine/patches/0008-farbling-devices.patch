 #include "third_party/blink/renderer/bindings/modules/v8/v8_speech_synthesis_event_init.h"
 #include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/alter_farbling.h"
 #include "third_party/blink/renderer/core/frame/deprecation/deprecation.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/web_feature.h"
@@ -44,6 +45,7 @@
 #include "third_party/blink/renderer/modules/speech/speech_synthesis_event.h"
 #include "third_party/blink/renderer/modules/speech/speech_synthesis_voice.h"
 #include "third_party/blink/renderer/platform/instrumentation/use_counter.h"
+#include "third_party/blink/renderer/platform/language.h"
 
 namespace blink {
 
@@ -85,7 +87,16 @@ SpeechSynthesis::SpeechSynthesis(LocalDOMWindow& window)
 void SpeechSynthesis::OnSetVoiceList(
     Vector<mojom::blink::SpeechSynthesisVoicePtr> mojom_voices) {
   voice_list_.clear();
+  // Alter: the voices for your language and the system's default, not every
+  // voice installed on this machine (engine/patches/0008).
+  const bool alter_trim = AlterFarbling::From(GetExecutionContext());
+  const String language = DefaultLanguage().GetString();
+  const String primary = language.DeprecatedSubstring(0, language.find('-'));
   for (auto& mojom_voice : mojom_voices) {
+    if (alter_trim && !mojom_voice->is_default &&
+        !mojom_voice->lang.StartsWithIgnoringAsciiCase(primary)) {
+      continue;
+    }
     voice_list_.push_back(
         MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
   }
