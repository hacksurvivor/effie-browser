diff --git a/third_party/blink/renderer/modules/keyboard/keyboard.cc b/third_party/blink/renderer/modules/keyboard/keyboard.cc
index 909d0dc3b9..ada636fb2d 100644
--- a/third_party/blink/renderer/modules/keyboard/keyboard.cc
+++ b/third_party/blink/renderer/modules/keyboard/keyboard.cc
@@ -4,7 +4,9 @@
 
 #include "third_party/blink/renderer/modules/keyboard/keyboard.h"
 
+#include "third_party/blink/renderer/core/dom/dom_exception.h"
 #include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/alter_farbling.h"
 #include "third_party/blink/renderer/modules/keyboard/keyboard_layout.h"
 #include "third_party/blink/renderer/modules/keyboard/keyboard_lock.h"
 #include "third_party/blink/renderer/platform/bindings/exception_state.h"
@@ -31,6 +33,12 @@ void Keyboard::unlock(ScriptState* state) {
 ScriptPromise<KeyboardLayoutMap> Keyboard::getLayoutMap(
     ScriptState* state,
     ExceptionState& exception_state) {
+  // Alter: which keyboard layout you type on is yours (engine/patches/0008).
+  if (AlterFarbling::From(ExecutionContext::From(state))) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kNotAllowedError,
+                                      "The keyboard layout isn't shared.");
+    return EmptyPromise();
+  }
   return keyboard_layout_->GetKeyboardLayoutMap(state, exception_state);
 }
 
