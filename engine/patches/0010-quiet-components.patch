+bool AlterKeepsComponent(const std::string& app_id) {
+  static constexpr std::string_view kKept[] = {
+      // Security.
+      "hfnkpimlhhgieaddgfemjhofmfblmnib",  // CRLSet: revoked certificates
+      "efniojlnjndmcbiieegkicadnoecjjef",  // PKI metadata: certificate logs
+      "ojjgnpkioondelmggbekfhllhdaimnho",  // STH set: certificate logs
+      "giekcmmlnklenlaomppkphknjmnnpneh",  // SSL error assistant
+      "khaoiebndkojlmppeemjhbpbandiljpe",  // file type policies (downloads)
+      "jflookgnkcckhobaglndicnbbgbonegd",  // safety tips (lookalike sites)
+      "imefjhfbkmcmebodilednhmaccmincoa",  // client-side phishing model
+      "ggkkehgbnfjpeggfpleeakpidbkibbmn",  // crowd deny (notification spam)
+      // Pages working as elsewhere.
+      "oimompecagnajdejgnnjijobebaeigek",  // Widevine (DRM video)
+      "neifaoindggfcjicffkgpmnlppeffabd",  // Widevine, Media Foundation
+      "jamhcnnkihinmdlkakkaopbjbbcngflc",  // hyphenation dictionaries
+      "kfoklmclfodeliojeaekpoflbkkhojea",  // origin trials
+      "llkgjffcdpffmhiakmfcdcblohccpfmo",  // origin trials
+      // Accessibility, downloaded only when used.
+      "mfhmdacoffpmifoibamicehhklffanao",  // Screen AI
+  };
+  return std::ranges::find(kKept, app_id) != std::end(kKept);
+}
